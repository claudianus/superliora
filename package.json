{
  "name": "@superliora/monorepo",
  "version": "0.1.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "build": "corepack pnpm -r run build",
    "build:packages": "corepack pnpm -r --filter \"./packages/*\" run build",
    "dev:cli": "corepack pnpm -C apps/liora run dev",
    "debug:cli": "corepack pnpm -C apps/liora run dev -- --debug",
    "install:liora": "node scripts/install-liora.mjs",
    "check:imports": "node scripts/check-workspace-imports.mjs",
    "check:layering": "node scripts/check-agent-core-layering.mjs",
    "check:loc": "node scripts/check-loc-budget.mjs",
    "check:dir": "node scripts/check-dir-budget.mjs",
    "check:settings-inventory": "node scripts/check-settings-inventory.mjs",
    "check:settings-inventory:strict": "node scripts/check-settings-inventory.mjs --fail",
    "check:unused-exports": "node scripts/report-unused-exports.mjs",
    "check:nix-workspace": "node scripts/check-nix-workspace.mjs",
    "check:agent-core-test-types": "node scripts/check-agent-core-test-types.mjs",
    "check:wall-clock-budgets": "node scripts/check-wall-clock-budgets.mjs",
    "check:changeset-inventory": "node scripts/changeset-inventory.mjs",
    "check:layering:strict": "node scripts/check-agent-core-layering.mjs --fail",
    "check:loc:strict": "node scripts/check-loc-budget.mjs --fail",
    "check:dir:strict": "node scripts/check-dir-budget.mjs --fail",
    "check:source-install": "node scripts/check-source-install.mjs",
    "check:slop": "node scripts/check-ai-slop.mjs",
    "check:test-baseline": "node scripts/check-test-baseline.mjs",
    "check:changeset": "node scripts/check-changeset.mjs",
    "check:cdn-latest": "node scripts/check-cdn-latest.mjs",
    "check:await-scan": "node scripts/check-await-scan.mjs",
    "dev:server": "corepack pnpm -C apps/liora run dev:server",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:fast": "node scripts/typecheck.mjs --direct",
    "typecheck:tsc": "node scripts/typecheck.mjs --compiler=tsc",
    "lint": "oxlint --type-aware",
    "lint:fix": "corepack pnpm run lint --fix",
    "sherif": "sherif",
    "test": "node scripts/test-local.mjs --all",
    "test:local": "node scripts/test-local.mjs",
    "test:all": "node scripts/test-local.mjs --all",
    "test:direct": "node scripts/test-local.mjs --direct",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gate": "corepack pnpm run lint && corepack pnpm run typecheck && node scripts/test-local.mjs",
    "gate:fast": "corepack pnpm run lint && node scripts/typecheck.mjs --direct && node scripts/test-local.mjs",
    "clean": "corepack pnpm -r run clean",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.7",
    "@types/node": "^22.15.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "4.1.4",
    "lint-staged": "16.4.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "sherif": "1.11.1",
    "simple-git-hooks": "2.13.1",
    "tsdown": "0.22.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --quiet",
      "oxlint --type-aware --quiet"
    ]
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "better-sqlite3",
      "esbuild",
      "node-pty",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ],
    "overrides": {
      "@hono/node-server@<1.19.15": "^1.19.15",
      "@protobufjs/utf8@<1.1.1": "^1.1.1",
      "@xmldom/xmldom@<0.9.12": "^0.9.12",
      "adm-zip@<0.6.0": "^0.6.1",
      "body-parser@<2.3.0": "^2.3.0",
      "brace-expansion@<5.0.9": "^5.0.9",
      "browserslist@<4.28.7": "^4.28.7",
      "cpu-features": "-",
      "esbuild@<0.28.1": "^0.28.1",
      "fast-uri@<3.1.6": "^3.1.6",
      "hono@<4.12.34": "^4.12.34",
      "ip-address@<10.3.1": "^10.3.1",
      "protobufjs@<7.6.5": "^7.6.5",
      "qs@<6.16.0": "^6.16.0",
      "sharp@<0.35.0": "^0.35.0",
      "tar@<7.5.21": "^7.5.22",
      "ws@<8.21.0": "^8.21.0"
    }
  }
}
