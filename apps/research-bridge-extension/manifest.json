{
  "manifest_version": 3,
  "name": "SuperLiora Research Bridge",
  "version": "0.1.0",
  "description": "Native-messaging bridge for logged-in Chrome history search (Ch5 Deep Research).",
  "permissions": ["nativeMessaging", "history"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
