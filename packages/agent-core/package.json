{
  "name": "@superliora/agent-core",
  "version": "0.16.4",
  "private": true,
  "description": "The unified agent engine for SuperLiora",
  "license": "MIT",
  "author": "SuperLiora Contributors",
  "homepage": "https://github.com/claudianus/superliora/tree/main/packages/agent-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claudianus/superliora.git",
    "directory": "packages/agent-core"
  },
  "bugs": {
    "url": "https://github.com/claudianus/superliora/issues"
  },
  "keywords": [
    "superliora",
    "agent",
    "ai",
    "llm",
    "session",
    "tools"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/fleet": "./src/fleet/index.ts",
    "#/*": [
      "./src/*.ts",
      "./src/*/index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./session/store": {
      "types": "./src/session/store/index.ts",
      "default": "./src/session/store/index.ts"
    },
    "./fleet": {
      "types": "./src/fleet/index.ts",
      "default": "./src/fleet/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:baseline": "vitest run",
    "typecheck": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:src": "tsc -p tsconfig.src.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@superliora/kaos": "workspace:^",
    "@superliora/kosong": "workspace:^",
    "@superliora/oauth": "workspace:^",
    "@superliora/protocol": "workspace:^",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "ignore": "^5.3.2",
    "jimp": "^1.6.1",
    "js-yaml": "^4.3.2",
    "node-pty": "^1.1.0",
    "nunjucks": "^3.2.4",
    "open": "^10.2.0",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "proper-lockfile": "^4.1.2",
    "regexp.escape": "^2.0.1",
    "smol-toml": "^1.7.1",
    "socks": "^2.8.9",
    "tar": "^7.5.22",
    "ulid": "^3.0.1",
    "undici": "^7.30.0",
    "yauzl": "^3.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/nunjucks": "^3.2.6",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/regexp.escape": "^2.0.0",
    "@types/sinon": "^21.0.1",
    "@types/tar": "^7.0.87",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "sinon": "^22.0.0",
    "yazl": "^3.3.1"
  }
}
